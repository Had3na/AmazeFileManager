       String stringRepresentation = String.format("#%06X", (0xFFFFFF & getAccent()));
 
       switch (stringRepresentation.toUpperCase()) {
+        case "#FF0000":
+          // Custom bright red accent for the futuristic theme.
+          // Apply the matching futuristic accent style based on the base theme (light, dark or black).
+          if (theme.equals(AppTheme.LIGHT)) setTheme(R.style.pref_accent_light_futuristic);
+          else if (theme.equals(AppTheme.BLACK)) setTheme(R.style.pref_accent_black_futuristic);
+          else setTheme(R.style.pref_accent_dark_futuristic);
+          break;
         case "#F44336":
           if (theme.equals(AppTheme.LIGHT)) setTheme(R.style.pref_accent_light_red);
           else if (theme.equals(AppTheme.BLACK)) setTheme(R.style.pref_accent_black_red);
